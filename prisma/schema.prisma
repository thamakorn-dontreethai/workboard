generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  plan      String   @default("enterprise")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  boards    Board[]
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  password       String?
  avatarInitials String
  avatarColor    String
  role           String         @default("Member")
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  assignedTasks  Task[]         @relation("Assignee")
  reportedTasks  Task[]         @relation("Reporter")
  comments       Comment[]
  activities     Activity[]
  notifications  Notification[]
  ownedBoards    Board[]        @relation("BoardOwner")
}

model Board {
  id           String     @id @default(cuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  description  String?    @default("")
  type         String     @default("general")
  color        String     @default("bg-blue-500")
  ownerId      String
  owner        User       @relation("BoardOwner", fields: [ownerId], references: [id])
  memberIds    String[]   @default([])
  isArchived   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastViewedAt DateTime   @default(now())
  groups       Group[]
  tasks        Task[]
  activities   Activity[]

  @@index([workspaceId])
  @@index([ownerId])
}

model BoardInvitation {
  id          String    @id @default(cuid())
  token       String    @unique
  boardId     String
  email       String
  role        String    @default("Member")
  status      String    @default("pending")
  invitedById String
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@index([token])
  @@index([boardId])
}

model Group {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("#0073ea")
  order       Int      @default(0)
  isCollapsed Boolean  @default(false)
  createdAt   DateTime @default(now())
  tasks       Task[]

  @@index([boardId])
}

model Task {
  id          String     @id @default(cuid())
  itemCode    String
  boardId     String
  board       Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String?    @default("")
  status      String     @default("todo")
  priority    String     @default("medium")
  assigneeId  String?
  assignee    User?      @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporterId  String
  reporter    User       @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  dueDate     DateTime?
  category    String     @default("General")
  order       Int        @default(0)
  isArchived  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  subtasks    Subtask[]
  comments    Comment[]
  activities  Activity[]

  @@index([boardId])
  @@index([groupId])
  @@index([assigneeId])
  @@index([status])
}

model Subtask {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([authorId])
}

model Activity {
  id          String   @id @default(cuid())
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  boardId     String?
  board       Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  type        String
  description String
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([boardId])
  @@index([actorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  taskId    String?
  boardId   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
