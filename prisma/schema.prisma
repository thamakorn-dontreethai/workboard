generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Workspace {
  id           String   @id @default(cuid())
  name         String
  description  String?  @default("")
  logo         String?
  icon         String?
  plan         String   @default("enterprise")
  privacy      String   @default("open")
  avatarColor  String   @default("bg-indigo-600")
  coverColor   String?
  isPinned     Boolean  @default(false)
  // Membership (userId/role/joinedAt per member) as JSON rather than a
  // join table — keeps this phase's migration additive and low-risk; can
  // be normalized into a real WorkspaceMember model later if per-member
  // querying is ever needed.
  members      Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastViewedAt DateTime @default(now())
  boards       Board[]
  posts        Post[]
  folders      Folder[]
  files        FileItem[]
  appointments Appointment[]
  dashboards   Dashboard[]
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  password       String?
  avatarInitials String
  avatarColor    String
  role           String         @default("Member")
  isActive       Boolean        @default(true)
  // Per-type opt-out switches for the Posts feed's notifications — each
  // defaults on so existing users keep getting notified until they turn
  // one off, rather than silently missing activity after this shipped.
  notifyPostLikes    Boolean @default(true)
  notifyPostComments Boolean @default(true)
  notifyNewPosts     Boolean @default(true)
  // LINE Messaging API linkage — lineUserId is set once the person finishes
  // the "connect LINE" flow (sends their link code to the bot). The code
  // fields are only populated while a link is pending and are cleared once
  // used or expired.
  lineUserId            String?
  lineLinkCode          String?
  lineLinkCodeExpiresAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  reportedTasks  Task[]         @relation("Reporter")
  comments       Comment[]
  activities     Activity[]
  notifications  Notification[]
  ownedBoards    Board[]        @relation("BoardOwner")
  personalTodos  PersonalTodo[]
  posts          Post[]
  postComments   PostComment[]
  postReactions  PostReaction[]
  uploadedFiles  FileItem[]
  appointments   Appointment[] @relation("AppointmentCreator")
  dashboards     Dashboard[]
}

model Board {
  id           String     @id @default(cuid())
  workspaceId  String
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       Folder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name         String
  description  String?    @default("")
  type         String     @default("general")
  color        String     @default("bg-blue-500")
  privacy      String     @default("main")
  ownerId      String
  owner        User       @relation("BoardOwner", fields: [ownerId], references: [id])
  memberIds    String[]   @default([])
  isArchived   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastViewedAt DateTime   @default(now())
  groups       Group[]
  tasks        Task[]
  activities   Activity[]

  @@index([workspaceId])
  @@index([ownerId])
  @@index([folderId])
}

model Folder {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("text-amber-400")
  isCollapsed Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  boards      Board[]

  @@index([workspaceId])
}

// Workspace file storage (PDF, Word, Excel, images, 3D models, etc.) — the
// bytes are stored as a base64 data URL, same approach already used for
// workspace cover images / avatars, so no separate object storage service
// is needed. Fine for a document library; not meant for huge media files.
model FileItem {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  caption      String?  @default("")
  mimeType     String
  size         Int
  dataUrl      String   @db.Text
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([workspaceId])
}

model BoardInvitation {
  id          String    @id @default(cuid())
  token       String    @unique
  boardId     String
  email       String
  role        String    @default("Member")
  status      String    @default("pending")
  invitedById String
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@index([token])
  @@index([boardId])
}

model Group {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("#0073ea")
  order       Int      @default(0)
  isCollapsed Boolean  @default(false)
  createdAt   DateTime @default(now())
  tasks       Task[]

  @@index([boardId])
}

model Task {
  id          String     @id @default(cuid())
  itemCode    String
  boardId     String
  board       Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String?    @default("")
  status      String     @default("todo")
  priority    String     @default("medium")
  // Plain id list rather than a relation table — same pattern already used
  // for Board.memberIds and Appointment.attendeeIds, so multiple people can
  // share a task without a join table.
  assigneeIds String[]   @default([])
  // Deprecated / unused by the app — superseded by assigneeIds above.
  // Kept (rather than dropped) because dropping it needs --accept-data-loss,
  // which this environment's safety policy blocks; ask the user to run that
  // migration manually if the column should actually be removed.
  assigneeId  String?
  reporterId  String
  reporter    User       @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  dueDate     DateTime?
  // Set once a "due soon" LINE/notification reminder has fired for the
  // task's current dueDate, so the periodic checker doesn't re-notify on
  // every poll. Cleared whenever dueDate changes (see updateTask).
  dueSoonReminderSentAt DateTime?
  category    String     @default("General")
  order       Int        @default(0)
  isArchived  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  subtasks    Subtask[]
  comments    Comment[]
  activities  Activity[]

  @@index([boardId])
  @@index([groupId])
  @@index([status])
}

model Subtask {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  // Files attached to the comment: [{ id, name, size, mimeType, url }] where
  // `url` holds the base64 data URL (same approach as FileItem.dataUrl). The
  // API never returns the data URL in lists — it serves each file from
  // /api/comments/[id]/attachments/[attId] instead.
  attachments Json   @default("[]")
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([authorId])
}

model Activity {
  id          String   @id @default(cuid())
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  boardId     String?
  board       Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  type        String
  description String
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([boardId])
  @@index([actorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  taskId    String?
  boardId   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Workspace Posts (a simple social feed scoped to one workspace) ────────

model Post {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId    String
  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  imageUrl    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  comments    PostComment[]
  reactions   PostReaction[]

  @@index([workspaceId])
  @@index([authorId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  @@index([postId])
}

model PostReaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

// Workspace-shared appointments/meetings — unlike PersonalTodo (private,
// per-user), these are visible to a workspace's members and drive both an
// in-app Notification and an email reminder for each attendee.
model Appointment {
  id                    String    @id @default(cuid())
  workspaceId           String
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boardId               String?
  createdById           String
  createdBy             User      @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  title                 String
  notes                 String?   @default("")
  startAt               DateTime
  // Empty = every current workspace member is an attendee.
  attendeeIds           String[]  @default([])
  reminderMinutesBefore Int       @default(30)
  isCompleted           Boolean   @default(false)
  reminderSentAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([workspaceId])
  @@index([startAt])
}

// A saved, named analytics report view over one workspace's boards/tasks —
// the widget list drives which charts render on its page; the numbers
// themselves are computed live from Task/Board data, never stored here.
model Dashboard {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?  @default("")
  widgets     String[] @default(["kpis", "distribution", "workload", "trend"])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

model PersonalTodo {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                  String
  notes                  String?   @default("")
  dueAt                  DateTime?
  reminderMinutesBefore  Int       @default(10)
  isCompleted            Boolean   @default(false)
  reminderSentAt         DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
}
